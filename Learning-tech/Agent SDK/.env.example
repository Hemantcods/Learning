# =====================================================================
# Google ADK Code Coverage Agent - Environment Configuration
# =====================================================================

# [REQUIRED] Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# [OPTIONAL] Gemini Model name (default: gemini-2.5-pro for advanced code reasoning)
# Recommended for coding agents: gemini-2.5-pro or gemini-2.5-flash
GEMINI_MODEL="gemini-2.5-pro"

# [REQUIRED] GitHub Personal Access Token (PAT)
# Needs 'repo' scope (or fine-grained: Contents R/W, Pull Requests R/W)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_your_personal_access_token_here"

# [REQUIRED] GitHub Repository URL or "owner/repo"
# Examples:
#   https://github.com/your-username/your-repo
#   your-username/your-repo
GITHUB_REPO_URL="https://github.com/your-username/your-repo"

# [OPTIONAL] Base branch to branch off and target with PRs (default: main)
TARGET_BRANCH="main"

# [OPTIONAL] Local workspace directory to clone the repo into (default: ./workspace)
WORKSPACE_DIR="./workspace"

# [OPTIONAL] Custom test command (default: auto-detected from repo or 'npm test')
TEST_COMMAND=""

# [OPTIONAL] Cron schedule expression for daily execution (default: "0 2 * * *" - 2:00 AM daily)
CRON_SCHEDULE="0 2 * * *"
