{
  "name": "google-adk-coverage-agent",
  "version": "1.0.0",
  "description": "Autonomous Code Coverage Agent and Daily Job using Google ADK in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "cron": "tsx src/index.ts --schedule",
    "build": "tsc",
    "start": "node dist/index.js",
    "web": "adk web src/agent.ts",
    "adk": "adk"
  },
  "keywords": ["google", "adk", "agent", "gemini", "typescript", "zod", "github", "coverage"],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@google/adk": "^2.0.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@google/adk-devtools": "^2.0.0",
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
